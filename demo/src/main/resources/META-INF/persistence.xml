<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="plataforma-jogos">
        <class>com.example.model.Usuario</class>
        <class>com.example.model.Jogo</class>
        <class>com.example.model.Biblioteca</class>
        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/plataformajogos"/>
            <property name="jakarta.persistence.jdbc.user" value="java"/>
            <property name="jakarta.persistence.jdbc.password" value="100609"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>